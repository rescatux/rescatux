set -e

apt-get install -y grub-theme-starfield

GRUB_FONTS_DIR="boot/grub/fonts"

if [ ! -d "${GRUB_FONTS_DIR}" ] ; then
	mkdir --parents "${GRUB_FONTS_DIR}"
fi

cp -a /usr/share/grub/themes/starfield/*pf2 "${GRUB_FONTS_DIR}"
